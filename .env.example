# SciCoreAgent model provider.
# Copy this file to .env and fill only your local machine's values.
# Never commit .env.
SCICORE_PROVIDER=deepseek
SCICORE_DEEPSEEK_API_KEY=replace-me
SCICORE_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
SCICORE_DEEPSEEK_MODEL=deepseek-chat

# Optional Postgres long-term memory. When unset, session chunks are retained
# in the local SQLite distillation outbox and the CLI remains fully offline.
# Install with: python -m pip install -e ".[memory-postgres]"
SCICORE_MEMORY_POSTGRES_DSN=
# Optional tenant/user boundary for Postgres memory retrieval and distillation.
SCICORE_MEMORY_USER_SCOPE=
# Semantic embedding backend (dual-tier).
#   default  -> SCICORE_EMBEDDING_BACKEND=hash : deterministic, offline,
#               byte-for-byte reproducible HASH embedding (dense_hash_fallback).
#   semantic -> SCICORE_EMBEDDING_BACKEND=sentence-transformers : real
#               sentence-transformers Dense vector (needs `pip install -e ".[memory-postgres]"`).
#               Then SCICORE_EMBEDDING_MODEL selects the model (default below).
SCICORE_EMBEDDING_BACKEND=hash
SCICORE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional pgvector ANN upgrade (dense).  Requires the `vector` extension:
#   docker compose --profile memory up -d memory-postgres   # uses pgvector/pgvector:pg15
# initialize() auto-detects the extension; without it the store keeps the JSONB
# cosine fallback unchanged.  No env var toggles this — it follows the image.


# Optional isolated OmicVerse backend. Keep heavy bioinformatics dependencies
# outside the main agent environment.
SCICORE_OMICVERSE_ENABLED=0
SCICORE_OMICVERSE_PYTHON=

# Optional remote bioinformatics workspace
BIO_REMOTE_HOST=
BIO_REMOTE_USER=
BIO_REMOTE_PORT=22
BIO_REMOTE_KEY=
BIO_REMOTE_WORK_DIR=
